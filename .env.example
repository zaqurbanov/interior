# MongoDB connection string (MongoDB Atlas or local mongod)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/interior?retryWrites=true&w=majority

# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true

# Initial admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database name (optional, defaults to "vladimir-fasij")
MONGODB_DB=vladimir-fasij

# Vercel Blob token for admin uploads (Vercel adds it automatically; for local
# uploads copy it from the Vercel dashboard or run `vercel env pull`)
BLOB_READ_WRITE_TOKEN=

# Email via Resend (optional). Without RESEND_API_KEY enquiries are saved but
# no emails go out. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Vladimir - Fasij <studio@vladimir-fasij.com>"
# Who gets new-enquiry alerts (comma-separated); defaults to the site's contact email
NOTIFY_EMAIL=
