# MongoDB connection string (MongoDB Atlas or local mongod)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/interior?retryWrites=true&w=majority

# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true

# Initial admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database name (optional, defaults to "vladimir-fasij")
MONGODB_DB=vladimir-fasij

# Vercel Blob token for admin uploads (Vercel adds it automatically; for local
# uploads copy it from the Vercel dashboard or run `vercel env pull`)
BLOB_READ_WRITE_TOKEN=
# Built-in frames are served from the Blob store (default in src/lib/frames-base.ts).
# Set to /frames to preview freshly extracted public/frames locally before uploading.
NEXT_PUBLIC_FRAMES_BASE=

# Email via Resend (optional). Without RESEND_API_KEY enquiries are saved but
# no emails go out. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Vladimir - Fasij <studio@vladimir-fasij.com>"
# Who gets new-enquiry alerts (comma-separated); defaults to the site's contact email
NOTIFY_EMAIL=

# Walkthrough frame jobs (admin → project → Walkthrough). Vercel cannot run
# ffmpeg, so frames are made by .github/workflows/story-frames.yml:
#   GITHUB_ACTIONS_TOKEN — fine-grained token, this repo only, "Actions: read and write"
#   GITHUB_REPO          — owner/name
#   FRAME_JOB_REF        — branch holding the workflow (default master)
# The repo also needs secrets BLOB_READ_WRITE_TOKEN and STORY_WEBHOOK_SECRET.
# On your own server with ffmpeg, set FRAME_JOB_DRIVER=local instead.
GITHUB_ACTIONS_TOKEN=
GITHUB_REPO=zaqurbanov/interior
FRAME_JOB_REF=master
FRAME_JOB_DRIVER=
# Shared with the workflow; signs the job's result (any long random string)
STORY_WEBHOOK_SECRET=
